# API server
PORT=3000
DATABASE_PATH=server/data/leads.sqlite
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-32-bytes
TRUST_PROXY_HOPS=1

# SMTP settings for lead notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

SMTP_FROM=Ultra website <your-gmail-address@gmail.com>
CONTACT_RECIPIENT=recipient@example.com
